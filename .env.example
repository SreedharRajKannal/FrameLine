# Meetily Pro Automation API
MEETILY_BASE_URL=http://10.0.21.53
MEETILY_API_KEY=V0a7YO5iog9D3KKATnBGcUL01izaEdJyDmV-lHvIaMw
MEETILY_WEBHOOK_SECRET=1slJcQ6g447PV_ILHv_j3fd9W1X89NQvSvx_FwdDGBo

# Ollama local LLM
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
# Set OLLAMA_NO_GPU=1 if Ollama crashes on start (GPU/CUDA driver issue on some machines)
# OLLAMA_NO_GPU=1

# Set to 1 to skip Ollama and load samples/expected_items.json instead
MOCK_LLM=0

# SQLite database path
DB_PATH=frameline.db

# Comma-separated list of speaker labels that are NOT the client (editor/director voices)
# In the sample transcript: Priya is the editor; Rahul is the client.
EDITOR_SPEAKERS=Priya,Host,Editor

# ── Vision / Video Indexing ──────────────────────────────────────────────────
# Set VISION_ENABLED=0 to disable video indexing and context generation
VISION_ENABLED=1
# Set MOCK_VISION=1 to skip real indexing (no ffmpeg/CLIP needed — for CI)
MOCK_VISION=0
# Seconds between sampled frames within each shot (for CLIP embedding)
FRAME_INTERVAL_SEC=2.0
# PySceneDetect content-change threshold (lower = more shots detected)
SCENE_THRESHOLD=27.0
# Ollama vision model for keyframe captions (leave blank to skip captions)
# Pull first: ollama pull moondream
CAPTION_MODEL=
# CLIP embedding device: cpu or cuda
CLIP_DEVICE=cpu
# Directory for video files and thumbnails (relative to cwd or absolute)
VIDEO_DATA_DIR=data/videos

# ── Vision Context & MiniCPM-V (Phase 3) ───────────────────────────────────
VISION_CONTEXT_ENABLED=1
MOCK_VISION_LLM=0
VISION_VLM_ENABLED=1
VISION_MODEL=minicpm-v4.5:8b
VISION_FRAME_INTERVAL_SEC=2.5
VISION_FRAME_MAX_EDGE=768
VISION_THINK_BUDGET_SEC=0
VISION_DEDUP_THRESHOLD=0

# ── YOLO detector + ByteTrack entity index ─────────────────────────────────
DETECTOR_ENABLED=1
DETECTOR_MODEL=yolo11n.pt
# Optional glossary path for open-vocabulary YOLO-World models
DETECTOR_GLOSSARY_PATH=
DETECT_FPS=4
DETECT_SEGMENTATION=0

