# Meetily Pro Automation API
MEETILY_BASE_URL=http://127.0.0.1:8420
MEETILY_API_KEY=your_meetily_api_key_here
MEETILY_WEBHOOK_SECRET=your_webhook_secret_here

# Ollama local LLM
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Set to 1 to skip Ollama and load samples/expected_items.json instead
MOCK_LLM=0

# SQLite database path
DB_PATH=frameline.db

# Comma-separated list of speaker labels that are NOT the client (editor/director voices)
EDITOR_SPEAKERS=Host,Editor
